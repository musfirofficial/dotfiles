// Config //
configuration {
modi:                        "drun,run";
show-icons:                  true;
display-drun:                " ";
drun-display-format:         "{name}";
font:                        "JetBrainsMono Nerd Font 8";
}

@import "~/.config/rofi/theme.rasi"

// Main Window //
window {
enabled:                     true;
fullscreen:                  false;
transparency:                "none";
cursor:                      "default";
spacing:                     0px;
padding:                     0px;
border:                      1px;
border-radius:               8px;
border-color:                @main-br;
background-color:            @main-bg;
width:                       400px;
height:                      420px;
location:                    center;
anchor:                      center;
}

// Main Box //
mainbox {
enabled:                     true;
spacing:                     8px;
padding:                     12px;
background-color:            transparent;
children:                    [ "inputbar", "listview" ];
}

// Inputbar //
inputbar {
enabled:                     true;
spacing:                     6px;
padding:                     6px 10px;
border-radius:               6px;
background-color:            @main-ex;
text-color:                  @main-fg;
children:                    [ "prompt", "entry" ];
}

prompt {
enabled:                     true;
background-color:            transparent;
text-color:                  inherit;
}

entry {
enabled:                     true;
background-color:            transparent;
text-color:                  inherit;
cursor:                      text;
placeholder:                 "Search...";
placeholder-color:           #666666;
}

// Grid Listview //
listview {
enabled:                     true;
columns:                     4;
lines:                       4;
cycle:                       true;
dynamic:                     true;
scrollbar:                   false;
layout:                      vertical;
reverse:                     false;
fixed-height:                true;
fixed-columns:               true;
spacing:                     6px;
background-color:            transparent;
cursor:                      "default";
}

// Elements //
element {
enabled:                     true;
spacing:                     4px;
padding:                     6px 4px;
border-radius:               6px;
background-color:            transparent;
text-color:                  @main-fg;
orientation:                 vertical;
cursor:                      pointer;
}

element selected.normal {
background-color:            @select-bg;
text-color:                  @select-fg;
}

element-icon {
background-color:            transparent;
text-color:                  inherit;
size:                        32px;
cursor:                      inherit;
horizontal-align:            0.5;
}

element-text {
background-color:            transparent;
text-color:                  inherit;
cursor:                      inherit;
vertical-align:              0.5;
horizontal-align:            0.5;
}
