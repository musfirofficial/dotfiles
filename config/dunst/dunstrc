[global]
monitor = 0
follow = none
width = 340
height = 200
origin = top-right
offset = 20x50
scale = 0
notification_limit = 5
progress_bar = true
indicate_hidden = yes
transparency = 0
separator_height = 1
separator_color = "#24273a"
padding = 14
horizontal_padding = 16
text_icon_padding = 12
frame_width = 1
frame_color = "#2a2b36"
gap_size = 6
font = JetBrainsMono Nerd Font 11
line_height = 4
format = "<b>%s</b>\n%b"
corner_radius = 12
mouse_left_click = close_current
mouse_right_click = close_all

[urgency_low]
background = "#141419"
foreground = "#cad3f5"
frame_color = "#2a2b36"
timeout = 5

[urgency_normal]
background = "#141419"
foreground = "#cad3f5"
frame_color = "#2a2b36"
timeout = 6

[urgency_critical]
background = "#181419"
foreground = "#ed8796"
frame_color = "#45222b"
timeout = 0
